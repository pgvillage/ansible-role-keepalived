global_defs {
  router_id {{ ansible_facts.fqdn }}
  script_user root
  enable_script_security
}

vrrp_script check_haproxy {
  script "/usr/bin/killall -0 haproxy"
  interval 2
  weight 2
}

vrrp_instance balancer {
  state {% if "1" in ansible_facts.fqdn %}
MASTER
{% else %}
BACKUP
{% endif %}
  interface {{ keepalived_interface }}
  virtual_router_id {{ keepalived_virtual_router_id }}
  priority {% if "1" in ansible_facts.fqdn %}
100
{% else %}
50
{% endif %}
{% set unicast_peers = keepalived_unicast_peers | reject('in', ansible_facts.all_ipv4_addresses) | list %}
{% if unicast_peers %}
  unicast_peer {
{% for peer in unicast_peers %}
    {{ peer }}
{% endfor %}
  }
{% endif %}
  virtual_ipaddress {
    {{ keepalived_vip_definition }}
  }
  track_script {
    check_haproxy
  }
  authentication {
    auth_type PASS
    auth_pass {{ keepalived_cluster_password }} 
  }
}
